<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ 云备份与换机迁移规则。
     cloud-backup：同 backup_rules.xml，饮食照片不入云（25MB 上限），WAL/SHM 事务现场不入包
     device-transfer：换机走本地通道无体积上限，饮食照片随迁；仍排除 WAL/SHM 事务现场 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diet_images"/>
        <exclude domain="database" path="database-wal"/>
        <exclude domain="database" path="database-shm"/>
        <exclude domain="database" path="database-journal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="database-wal"/>
        <exclude domain="database" path="database-shm"/>
        <exclude domain="database" path="database-journal"/>
    </device-transfer>
</data-extraction-rules>
