<?xml version="1.0" encoding="utf-8"?>
<!-- 尺寸按官方换算表：2格宽=110dp、4格宽=250dp。高度锁定 2 格，仅允许横向缩放，
     避免纵向拉伸出大片空白；targetCellWidth/Height 在 API 31+ 优先生效。
     updatePeriodMillis=0：数据变化由 WidgetUpdater 推送刷新（增删记录/导入/换主题均触发），
     30 分钟轮询只会在数据没变时白白拉起进程做 4 次数据库查询，Glance 官方推荐禁用 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@mipmap/icon_logo"
    android:previewLayout="@layout/weight_widget_preview"
    android:description="@string/weight_widget_description" />
